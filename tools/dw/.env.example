# tools/dw/.env.example -- kopiera till tools/dw/.env (gitignorerad: .gitignore har .env och *.env) och fyll i.
# Alternativ: satt miljovariabeln BCG_DW_ENV till en befintlig .env (t.ex. Business_Analytics\.env).
# Server- och databasnamn ar konfiguration, inte hemligheter -- men de committas ANDA aldrig (KANSLIGHETSREGISTER: datakallstrangar).
# Vardena finns hos den som forvaltar DW (IT).
FABRIC_SERVER=
FABRIC_DATABASE=
FABRIC_DRIVER=ODBC Driver 17 for SQL Server
