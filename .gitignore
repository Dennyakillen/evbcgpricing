# ============================================================================
# BCG pricing repo (evbcgpricing) -- .gitignore
# Enkel regel: pusha allt UTOM Excel-output och uppenbart skrap.
# Stadning av ovrigt skrap sker nar projektet ar klart (medvetet beslut).
# Utvecklare: Jens Palmo. Senast reviderad: 2026-05-26.
# ============================================================================

# --- Excel (det du uttryckligen INTE vill ha i Git) --------------------------
*.xlsx
*.xls
*.xlsm

# --- Virtuella miljoer + Python-skrap ----------------------------------------
.venv/
venv/
env/
**/.venv/
**/venv/
__pycache__/
**/__pycache__/
*.py[cod]
.ipynb_checkpoints/

# --- Tunga binarer / radata (bor i V2_New/Azure, inte i Git) -----------------
*.parquet
*.duckdb
*.duckdb.wal
*.yxdb
*.zip
*.7z

# --- Hemligheter (ska ALDRIG in i Git) ---------------------------------------
*.env
.env
*secret*
*.key
*.pem
*.pfx

# --- OS / editor -------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/

# --- Backupfiler -------------------------------------------------------------
*.bak
*.bak-*

